
---
import Layout from '../../layouts/Layout.astro';
import { withBase } from '../../utils/paths';


const musicians = [
{
    name: 'Marcus Miller',
    role: 'Bajista',
    image: withBase('/images/musicos/MarcusMiller.png'),
    slug: 'marcus-miller',
  },
  {
    name: 'Alex Han',
    role: 'Saxofonista',
    image: withBase('/images/musicos/AlexHan.jpeg'),
    slug: 'alex-han',
  },
  {
    name: 'Gretchen Parlato',
    role: 'Vocalista',
    image: withBase('/images/musicos/GretchenParlato.jpeg'),
    slug: 'gretchen-parlato',
  },
];
---
<Layout title="Músicos" description="Los músicos detrás de los discos de Groove Soul.">
  <section class="container directory">
    <p class="eyebrow">DETRÁS DE CADA SONIDO</p>
    <h1 class="page-title">Los músicos<br /><span>también cuentan.</span></h1>
    <p class="lead">
      Instrumentistas, compositores y productores que dejan su huella
      en los discos que escuchamos.
    </p>

    <div class="musician-grid">
      {musicians.map((musician) => (
          <a class="musician-card" href={withBase(`/musicos/${musician.slug}/`)}>
          <img src={musician.image} alt={`Retrato de ${musician.name}`} />
          <h2>{musician.name}</h2>
          <p>{musician.role}</p>
          <span class="text-link">Conocer su historia ↗</span>
        </a>
      ))}
    </div>
  </section>

  <style>
    .directory {
      padding-top: 75px;
    }

    .page-title span {
      color: var(--gold);
      font-style: italic;
    }

    .lead {
      margin-bottom: 50px;
    }

    .musician-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 25px;
    }
    .musician-card {
      display: block;
      overflow: hidden;
    }

    .musician-card img {
      display: block;
      width: 100%;
      aspect-ratio: 4 / 5;
      object-fit: cover;
      background: var(--surface);
      filter: saturate(0.8);
      transition: transform 250ms ease;
    }
    .musician-card h2 {
      margin: 14px 0 0;
      font-family: var(--serif);
      font-size: 25px;
      font-weight: 500;
    }

    .musician-card p {
      margin: 3px 0 12px;
      color: var(--muted);
      font-size: 13px;
    }


    @media (max-width: 650px) {
      .musician-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 20px 14px;
      }
      .musician-card {
        display: block;
        overflow: hidden;
      }
    }
.musician-card:hover img {
  transform: scale(1.035);
}
  </style>
</Layout>
