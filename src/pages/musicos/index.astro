
---
import Layout from '../../layouts/Layout.astro';

const musicians = [
  {
    name: 'Pino Palladino',
    role: 'Bajo eléctrico',
    image: 'https://commons.wikimedia.org/wiki/Special:FilePath/Pino_Palladino.jpg',
    href: '/musicos/pino-palladino/',
  },
];
---
<Layout title="Músicos" description="Los músicos detrás de los discos de Groove Soul.">
  <section class="container directory">
    <p class="eyebrow">DETRÁS DE CADA SONIDO</p>
    <h1 class="page-title">Los músicos<br /><span>también cuentan.</span></h1>
    <p class="lead">
      Instrumentistas, compositores y productores que dejan su huella
      en los discos que escuchamos.
    </p>

    <div class="musician-grid">
      {musicians.map((musician) => (
        <a class="musician-card" href={musician.href}>
          <img src={musician.image} alt={`Retrato de ${musician.name}`} />
          <h2>{musician.name}</h2>
          <p>{musician.role}</p>
          <span class="text-link">Conocer su historia ↗</span>
        </a>
      ))}
    </div>
  </section>

  <style>
    .directory {
      padding-top: 75px;
    }

    .page-title span {
      color: var(--gold);
      font-style: italic;
    }

    .lead {
      margin-bottom: 50px;
    }

    .musician-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 25px;
    }

    .musician-card img {
      width: 100%;
      aspect-ratio: 4 / 5;
      object-fit: cover;
      background: var(--surface);
      filter: saturate(0.8);
    }

    .musician-card h2 {
      margin: 14px 0 0;
      font-family: var(--serif);
      font-size: 25px;
      font-weight: 500;
    }

    .musician-card p {
      margin: 3px 0 12px;
      color: var(--muted);
      font-size: 13px;
    }

    @media (max-width: 650px) {
      .musician-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 20px 14px;
      }
    }
  </style>
</Layout>
